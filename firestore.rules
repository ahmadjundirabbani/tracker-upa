rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    // --- 1. User Profile Rules ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
    }

    // --- 2. Worship Targets Rules ---
    match /users/{userId}/targets/{targetId} {
      allow read, write: if isOwner(userId);
    }

    // --- 3. Worship Activity Log Rules ---
    match /users/{userId}/activities/{activityId} {
      allow read, write: if isOwner(userId);
    }

    // --- 4. Worship Groups Rules ---
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // --- 5. Group Members Subcollection ---
    match /groups/{groupId}/members/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // --- 6. Nudges/Reminders Collection ---
    match /nudges/{nudgeId} {
      allow read: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
    }
  }
}
